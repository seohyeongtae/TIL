<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dao.TabDao">
	

	
	<insert id="insert" parameterType="tab">
		INSERT INTO TAB VALUES (#{id},#{pwd},#{num})
	</insert>
	
	<update id="update" parameterType="tab">
		UPDATE TAB SET PWD=#{pwd},NUM=#{num} WHERE ID=#{id}
	</update>
	
	<delete id="delete" parameterType="String">
		DELETE FROM TAB WHERE ID=#{k}
	</delete>
		
	<select id="select" parameterType="String" 
	resultType="tab">
		SELECT * FROM TAB WHERE ID =#{k}
	</select>
	
	<select id="selectall" resultType="tab">
		SELECT * FROM TAB
	</select>
		
	
	
</mapper>






















