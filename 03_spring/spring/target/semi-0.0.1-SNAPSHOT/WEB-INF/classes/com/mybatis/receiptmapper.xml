<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org/DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dao.ReceiptDao">
	

	<!--  이거 영수증 아이디도 자동생성으로?? 날짜+시퀀스 이런식으로???? -->
	<insert id="insert" parameterType="receipt">
		INSERT INTO RECEIPT VALUES (#{id},#{tab_id},SYSDATE,#{payment},#{total})
	</insert>
	
	<update id="update" parameterType="receipt">
		UPDATE RECEIPT SET TAB_ID=#{tab_id},SYSDATE,PAYMENT=#{payment},TOTAL=#{total} WHERE ID=#{id}
	</update>
	
	<delete id="delete" parameterType="String">
		DELETE FROM RECEIPT WHERE ID=#{k}
	</delete>
		
	<select id="select" parameterType="String" 
	resultType="receipt">
		SELECT * FROM RECEIPT WHERE ID =#{k}
	</select>
	
	<select id="selectall" resultType="receipt">
		SELECT * FROM RECEIPT
	</select>
		
	
	
</mapper>






















